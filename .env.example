# Copy to .env.local for local development against your Supabase project.
# Leave empty to run the offline demo (sample hospital, data kept on this device).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: pre-fills the hospital code on the login screen
VITE_HOSPITAL_CODE=
# Optional: shown on the login screen
VITE_HOSPITAL_NAME=
